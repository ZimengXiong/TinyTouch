[Unit]
Description=TinyTouch SQLite backup to local storage and private GitHub Releases
After=docker.service
ConditionPathIsReadWrite=/srv/backups/tinytouch

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/srv/services/tinytouch-api/software/api
ExecStart=/bin/sh /srv/services/tinytouch-api/software/api/backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/backups/tinytouch
